{
  "name": "cmi-neuroqc-offline",
  "version": "2.0.0",
  "description": "Child Mind Institute - Neuroimaging Quality Control Platform (Fully Offline)",
  "type": "module",
  "main": "backend/server.js",
  "bin": "backend/server.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd frontend && vite",
    "dev:backend": "nodemon backend/server.js",
    "build": "cd frontend && vite build",
    "start": "node backend/server.js",
    "init-db": "node backend/init-database.js",
    "preview": "cd frontend && vite preview"
  },
  "pkg": {
    "assets": [
      "frontend/dist/**/*",
      "data/**/*",
      "database/**/*",
      "backend/**/*",
      "node_modules/better-sqlite3/**/*"
    ],
    "targets": [
      "node20-macos-x64"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.76.1",
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^9.6.0",
    "better-sqlite3-multiple-ciphers": "^12.4.1",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "ssh2": "^1.15.0",
    "tslint": "^6.1.3",
    "vite": "^5.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "neuroimaging",
    "quality-control",
    "crowdsourcing",
    "brain-imaging",
    "child-mind-institute"
  ],
  "author": "Mike",
  "license": "Apache-2.0"
}
