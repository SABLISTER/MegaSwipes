{
  "name": "cmi-neuroqc-offline",
  "version": "2.0.0",
  "description": "Child Mind Institute - Neuroimaging Quality Control Platform (Fully Offline)",
  "type": "module",
  "scripts": {
    "check-node": "node scripts/check-node-version.js",
    "preinstall": "npm run check-node",
    "postinstall": "npm rebuild better-sqlite3",
    "rebuild-native": "npm rebuild better-sqlite3",
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" --kill-others-on-fail --kill-others \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "cd frontend && vite --host",
    "dev:backend": "nodemon backend/server.js",
    "build": "cd frontend && vite build",
    "start": "node backend/server.js",
    "init-db": "node backend/init-database.js",
    "preview": "cd frontend && vite preview"
  },
  "dependencies": {
    "@napi-rs/cli": "^3.5.1",
    "@supabase/supabase-js": "^2.98.0",
    "axios": "^1.13.6",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.2",
    "better-sqlite3-multiple-ciphers": "^12.6.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^6.1.0",
    "dotenv": "^16.6.1",
    "eslint": "^10.0.2",
    "express": "^4.22.1",
    "express-rate-limit": "^7.5.1",
    "form-data": "^4.0.5",
    "fzf": "^0.5.2",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.3",
    "loader": "^2.1.1",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "ssh2": "^1.17.0",
    "tslint": "^6.1.3",
    "vite": "^6.4.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.14",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": "20.11.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "neuroimaging",
    "quality-control",
    "crowdsourcing",
    "brain-imaging",
    "child-mind-institute"
  ],
  "author": "Balls",
  "license": "Apache-2.0"
}
